# PerkOS App QA — safe template. Copy to .env.qa only in the QA runtime.
# Never commit real credentials or reuse Development/Production Admin keys.

NEXT_PUBLIC_SITE_URL=https://qa.perkos.xyz
PERKOS_API_URL=https://qa.api.perkos.xyz
NEXT_PUBLIC_PERKOS_CHAT_URL=wss://qa.chat.perkos.xyz/chat
NEXT_PUBLIC_PERKOS_PAY_URL=https://test.pay.perkos.xyz
PERKOS_ENVIRONMENT=qa

# Firebase Web SDK configuration for the isolated perkos-app-qa project.
# Populate after the QA Firebase Web App is provisioned.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=perkos-app-qa.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=perkos-app-qa
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=perkos-app-qa.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (server-only; inject from the QA secret store).
FIREBASE_PROJECT_ID=perkos-app-qa
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Environment-specific auth and service credentials.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
NEXT_PUBLIC_PERKOS_WHITELIST=
NEXT_PUBLIC_ALCHEMY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERKOS_LLM_GATEWAY_URL=https://api.llm.perkos.xyz
PERKOS_LLM_ADMIN_TOKEN=
RESEND_API=
EMAIL_FROM="PerkOS QA <noreply@perkos.xyz>"
CONTACT_EMAIL_TO=
ACCESS_EMAIL_TO=
