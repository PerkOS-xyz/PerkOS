# @perkos/shared-client@0.1.x declares an OPTIONAL peer on
# @perkos/shared-types@^0.1.0, but this app uses shared-types@^0.3.0. The
# version mismatch makes `npm ci` (strict peer resolution) fail with ERESOLVE
# even though the peer is optional and structurally compatible — this is what
# breaks CI's `npm ci` step on every commit. Relax peer resolution so clean
# installs (CI + local) succeed. Remove once @perkos/shared-client publishes a
# build whose peer range allows @perkos/shared-types ^0.3.
legacy-peer-deps=true
