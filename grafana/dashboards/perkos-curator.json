{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Datasource that scrapes the perkos-miniapp /metrics endpoint",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "PerkOS — Curator / Hibernation",
  "uid": "perkos-curator",
  "tags": ["perkos", "curator", "hibernation"],
  "schemaVersion": 38,
  "version": 1,
  "timezone": "",
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": false, "text": "Prometheus", "value": "${DS_PROMETHEUS}" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Curator hibernations — last 24h",
      "description": "Live-mode hibernations the curator performed. Empty (zero series) is normal if PERKOS_CURATOR_DRY_RUN is still true.",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (result) (increase(perkos_curator_hibernations_total[24h]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "Decision distribution — last 24h",
      "description": "Why the curator decided what it decided. Heavy 'skipped-not-idle' is healthy on a busy day; heavy 'idle' is the signal real hibernations are flowing.",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (reason) (increase(perkos_curator_decision_total[24h]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "legend": { "displayMode": "list", "placement": "right" },
        "pieType": "donut"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Average tick duration (live runs)",
      "description": "Mean seconds the curator spent in a single tick. Sustained > 10s usually means ECS describe-services is rate-limited and we should slow the cron.",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "rate(perkos_curator_tick_duration_seconds_sum{dryRun=\"false\"}[1h]) / rate(perkos_curator_tick_duration_seconds_count{dryRun=\"false\"}[1h])",
          "legendFormat": "avg seconds / tick",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "heatmap",
      "title": "Tick duration distribution",
      "description": "Heatmap of curator tick durations — wide bands mean the per-tick work is noisy. Tightening this distribution is the goal when scaling ECS reads.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (le) (increase(perkos_curator_tick_duration_seconds_bucket[5m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": { "unit": "s" },
        "color": { "scheme": "Spectral", "mode": "scheme", "exponent": 0.5 }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Curator ticks vs decisions vs hibernations",
      "description": "Three lines that together show the funnel: how often the curator runs, how many candidates it examined, how many ended up hibernated.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(perkos_curator_tick_duration_seconds_count[5m])) * 60",
          "legendFormat": "ticks/min",
          "refId": "A"
        },
        {
          "expr": "sum(rate(perkos_curator_decision_total[5m])) * 60",
          "legendFormat": "decisions/min",
          "refId": "B"
        },
        {
          "expr": "sum(rate(perkos_curator_hibernations_total{result=\"ok\"}[5m])) * 60",
          "legendFormat": "hibernations/min",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 5 }
        }
      }
    }
  ]
}
