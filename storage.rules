rules_version = '2';

// PerkOS Storage rules.
//
// Chat attachments live under a wallet-scoped path. The message embeds the
// file's download URL (a capability token), so consumers (the agent, other
// project members) fetch via that URL — which carries its own token and
// bypasses these rules. Direct SDK reads are therefore limited to the OWNING
// wallet as defence in depth (a signed-in stranger who guesses/obtains a path
// still can't read another wallet's file). Uploads are restricted to the owning wallet
// (uid == lowercased address, matching the Firestore `isSelf` convention)
// with a hard size cap that mirrors MAX_ATTACHMENT_BYTES.
service firebase.storage {
  match /b/{bucket}/o {
    match /attachments/{wallet}/{conversationId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == wallet;
      allow write: if request.auth != null
                   && request.auth.uid == wallet
                   && request.resource.size < 25 * 1024 * 1024;
    }

    // Everything else: deny.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
