rules_version = '2';

// Deploy with:
//   cd MiniApp && firebase deploy --only firestore:rules
//
// The Admin SDK (server scripts, Cloud Functions) bypasses all rules — these
// are only enforced for direct client SDK requests.

service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers ------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // Wallet auth flow mints custom tokens with uid = walletAddress.toLowerCase()
    function isSelf(walletAddress) {
      return isSignedIn() && request.auth.uid == walletAddress;
    }

    // Alpha-access allowlist --------------------------------------------
    //
    // A wallet holder can read their own allowlist doc to discover whether
    // they're approved. Writes are admin-only (the seed script + future
    // request-access workflow uses Admin SDK and bypasses rules).

    match /allowlist/{walletAddress} {
      allow read: if isSelf(walletAddress);
      allow write: if false;
    }

    // Per-wallet workspace ----------------------------------------------
    //
    // /wallets/{addr}/** is owned by the wallet holder. Reads + writes
    // require the request to come from a session whose uid matches.

    match /wallets/{walletAddress}/{document=**} {
      allow read, write: if isSelf(walletAddress);
    }

    // Privacy invariant: conversation message BODIES never live in
    // Firestore. The C-hybrid model stores message content on the host
    // agent's filesystem (`~/.perkos/conversations/{convId}/messages.jsonl`)
    // — Firestore holds only metadata under
    // /wallets/{addr}/conversations/{convId}.
    //
    // Explicitly deny direct client writes to any nested `messages`
    // subcollection under a conversation, regardless of caller. The Admin
    // SDK (used by PerkOS-Chat for `lastMessageAt` bumps on the parent
    // doc) bypasses these rules, so nothing useful is blocked.
    //
    // NOTE: this rule is matched AFTER the broader workspace rule above.
    // Firestore evaluates all matching rules; the most specific deny wins
    // because a single `false` in any matched rule denies the operation.

    match /wallets/{walletAddress}/conversations/{convId}/messages/{messageId} {
      allow read, write: if false;
    }

    // Receipts: signed attestations of a conversation. Wallet owner reads
    // and creates their own. The signed manifest + signature are immutable
    // after creation. The single permitted client-side update path is the
    // wallet attaching an on-chain anchor record AFTER signing — and only
    // once, no overwrites. Anything else (including a second anchor) is
    // rejected. Deletes are blocked entirely.

    match /wallets/{walletAddress}/receipts/{receiptId} {
      allow read: if isSelf(walletAddress);
      allow create: if isSelf(walletAddress);

      allow update: if isSelf(walletAddress)
        && !('anchor' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['anchor'])
        && request.resource.data.anchor is map
        && request.resource.data.anchor.chainId is int
        && request.resource.data.anchor.contractAddress is string
        && request.resource.data.anchor.receiptId is string
        && request.resource.data.anchor.txHash is string;

      allow delete: if false;
    }

    // Public submissions -------------------------------------------------
    //
    // request-access and contact form submissions are written by the Admin
    // SDK (Next.js API routes use admin creds), so we lock direct client
    // access entirely.

    match /access_requests/{id} {
      allow read, write: if false;
    }

    match /contact_messages/{id} {
      allow read, write: if false;
    }

    // Global agent registry ---------------------------------------------
    //
    // /agents/{agentName} contains the relayApiKey that lets that agent
    // authenticate against chat.perkos.xyz. Only the Admin SDK (the
    // MiniApp's /api/agents/launch endpoint and PerkOS-Chat's verifier)
    // may touch these docs. Browser clients NEVER read the registry —
    // exposing relayApiKey to a malicious wallet would let it impersonate
    // any registered agent.

    match /agents/{agentName} {
      allow read, write: if false;
    }

    // Default deny -------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
