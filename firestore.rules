rules_version = '2';

// Deploy with:
//   cd MiniApp && firebase deploy --only firestore:rules
//
// The Admin SDK (server scripts, Cloud Functions) bypasses all rules — these
// are only enforced for direct client SDK requests.

service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers ------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // Wallet auth flow mints custom tokens with uid = walletAddress.toLowerCase()
    function isSelf(walletAddress) {
      return isSignedIn() && request.auth.uid == walletAddress;
    }

    // Membership / sharing helpers (GitHub-like) ------------------------
    //
    // Members are recorded (Admin SDK, via PerkOS-API) at
    //   /wallets/{owner}/organizations/{orgId}/members/{memberUid}
    //   /wallets/{owner}/projects/{projectId}/members/{memberUid}
    // keyed by the member's uid (= their wallet, lowercased). These helpers
    // let a member READ (and, with editor/owner role, WRITE) the owner's org /
    // project subtree. Rules are ADDITIVE (Firestore grants if ANY match
    // allows), so the owner keeps full access via the workspace wildcard.

    function isOrgMember(w, orgId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/wallets/$(w)/organizations/$(orgId)/members/$(request.auth.uid));
    }
    function orgMemberRole(w, orgId) {
      return get(/databases/$(database)/documents/wallets/$(w)/organizations/$(orgId)/members/$(request.auth.uid)).data.role;
    }
    function isProjectMember(w, pid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/wallets/$(w)/projects/$(pid)/members/$(request.auth.uid));
    }
    function projectMemberRole(w, pid) {
      return get(/databases/$(database)/documents/wallets/$(w)/projects/$(pid)/members/$(request.auth.uid)).data.role;
    }
    function projectOrgId(w, pid) {
      return get(/databases/$(database)/documents/wallets/$(w)/projects/$(pid)).data.orgId;
    }
    // Editors/owners (by project role OR org role) may write the project subtree.
    function canWriteProject(w, pid) {
      return (isProjectMember(w, pid) && projectMemberRole(w, pid) in ['owner', 'editor'])
        || (isOrgMember(w, projectOrgId(w, pid)) && orgMemberRole(w, projectOrgId(w, pid)) in ['owner', 'editor']);
    }

    // Alpha-access allowlist --------------------------------------------
    //
    // A wallet holder can read their own allowlist doc to discover whether
    // they're approved. Writes are admin-only (the seed script + future
    // request-access workflow uses Admin SDK and bypasses rules).

    match /allowlist/{walletAddress} {
      allow read: if isSelf(walletAddress);
      allow write: if false;
    }

    // Username registry (unique handles) --------------------------------
    //
    // /usernames/{lowercased} → { wallet } maps a chosen handle to its owner.
    // Used to give humans a collision-free @-mention label. Anyone signed in
    // can READ (availability checks + resolving a mention). A handle can be
    // CREATED only when free (the doc doesn't exist yet) and stamped with the
    // caller's own wallet; UPDATE/DELETE only by the current owner (so a
    // rename frees the old handle). Because a taken handle already exists,
    // another wallet's attempt falls under `update` and is denied — that's
    // the uniqueness guarantee. Profile itself lives at
    // /wallets/{w}/profile/main (owner-only via the workspace wildcard).

    match /usernames/{uname} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.wallet == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.wallet == request.auth.uid
        && request.resource.data.wallet == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.wallet == request.auth.uid;
    }

    // Per-wallet workspace ----------------------------------------------
    //
    // /wallets/{addr}/** is owned by the wallet holder. Reads + writes
    // require the request to come from a session whose uid matches.

    match /wallets/{walletAddress}/{document=**} {
      allow read, write: if isSelf(walletAddress);
    }

    // Privacy invariant: conversation message BODIES never live in
    // Firestore. The C-hybrid model stores message content on the host
    // agent's filesystem (`~/.perkos/conversations/{convId}/messages.jsonl`)
    // — Firestore holds only metadata under
    // /wallets/{addr}/conversations/{convId}.
    //
    // Explicitly deny direct client writes to any nested `messages`
    // subcollection under a conversation, regardless of caller. The Admin
    // SDK (used by PerkOS-Chat for `lastMessageAt` bumps on the parent
    // doc) bypasses these rules, so nothing useful is blocked.
    //
    // NOTE: this rule is matched AFTER the broader workspace rule above.
    // Firestore evaluates all matching rules; the most specific deny wins
    // because a single `false` in any matched rule denies the operation.

    match /wallets/{walletAddress}/conversations/{convId}/messages/{messageId} {
      allow read, write: if false;
    }

    // Receipts: signed attestations of a conversation. Wallet owner reads
    // and creates their own. The signed manifest + signature are immutable
    // after creation. The single permitted client-side update path is the
    // wallet attaching an on-chain anchor record AFTER signing — and only
    // once, no overwrites. Anything else (including a second anchor) is
    // rejected. Deletes are blocked entirely.

    match /wallets/{walletAddress}/receipts/{receiptId} {
      allow read: if isSelf(walletAddress);
      allow create: if isSelf(walletAddress);

      allow update: if isSelf(walletAddress)
        && !('anchor' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['anchor'])
        && request.resource.data.anchor is map
        && request.resource.data.anchor.chainId is int
        && request.resource.data.anchor.contractAddress is string
        && request.resource.data.anchor.receiptId is string
        && request.resource.data.anchor.txHash is string;

      allow delete: if false;
    }

    // Public submissions -------------------------------------------------
    //
    // request-access and contact form submissions are written by the Admin
    // SDK (Next.js API routes use admin creds), so we lock direct client
    // access entirely.

    match /access_requests/{id} {
      allow read, write: if false;
    }

    match /contact_messages/{id} {
      allow read, write: if false;
    }

    // Global agent registry ---------------------------------------------
    //
    // /agents/{agentName} contains the relayApiKey that lets that agent
    // authenticate against chat.perkos.xyz. Only the Admin SDK (the
    // MiniApp's /api/agents/launch endpoint and PerkOS-Chat's verifier)
    // may touch these docs. Browser clients NEVER read the registry —
    // exposing relayApiKey to a malicious wallet would let it impersonate
    // any registered agent.

    match /agents/{agentName} {
      allow read, write: if false;
    }

    // Provisioning jobs --------------------------------------------------
    //
    // /provision_jobs/{jobId} is written by /api/agents/launch (Admin SDK)
    // and updated by the worker (Admin SDK). The owner wallet reads it
    // via Firestore client SDK to render the "Provisioning…" UI with
    // live log tail.
    //
    // /provision_jobs/{jobId}/log/* is an append-only audit trail of the
    // worker's progress. Read-only for the owner; never writeable from
    // the client.

    match /provision_jobs/{jobId} {
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.walletAddress;
      allow write: if false;

      match /log/{entryId} {
        allow read: if request.auth != null
                    && request.auth.uid == get(/databases/$(database)/documents/provision_jobs/$(jobId)).data.walletAddress;
        allow write: if false;
      }
    }

    // Membership / sharing access (cross-wallet) ------------------------
    //
    // Additive grants on top of the owner's workspace wildcard. An ORG member
    // can read the org + the member roster, and read ALL projects in that org
    // (incl. tasks + project chat). A PROJECT member can read that one project.
    // Editors/owners can also write the project subtree (tasks, board, chat).
    // Discovery happens via the member's own /wallets/{me}/sharedOrgs +
    // /sharedProjects pointers (covered by the workspace wildcard above).

    match /wallets/{w}/organizations/{orgId} {
      allow read: if isSelf(w) || isOrgMember(w, orgId);
      match /members/{memberUid} {
        allow read: if isSelf(w) || isOrgMember(w, orgId);
      }
    }

    match /wallets/{w}/projects/{pid} {
      allow read: if isSelf(w)
        || isProjectMember(w, pid)
        || (resource != null && isOrgMember(w, resource.data.orgId));
      // The owner or an editor/owner-role member may update the project doc.
      allow write: if isSelf(w) || canWriteProject(w, pid);

      // Tasks + chat: readable by any member, writable by editors/owners. These
      // are listed explicitly (NOT a `{document=**}` write) so editor write
      // CANNOT reach the `members` subcollection — membership changes go only
      // through the owner / the server API (privilege-escalation guard).
      match /tasks/{tid} {
        allow read: if isSelf(w)
          || isProjectMember(w, pid)
          || isOrgMember(w, projectOrgId(w, pid));
        allow write: if isSelf(w) || canWriteProject(w, pid);
      }
      // Project (board) chat. NOTE: this is a DIFFERENT collection from
      // `conversations/{convId}/messages` (the C-hybrid DM/channel bodies that
      // are denied above + stored off-Firestore). Project board messages —
      // postProjectMessage status updates from agents + human posts — are
      // intentionally Firestore-resident and in-scope for project/org members;
      // editors/owners may write them.
      match /messages/{mid} {
        allow read: if isSelf(w)
          || isProjectMember(w, pid)
          || isOrgMember(w, projectOrgId(w, pid));
        allow write: if isSelf(w) || canWriteProject(w, pid);
      }
      // Member roster: readable by members; writes are owner-only (via the
      // workspace wildcard's isSelf) — never granted to editors.
      match /members/{memberUid} {
        allow read: if isSelf(w)
          || isProjectMember(w, pid)
          || isOrgMember(w, projectOrgId(w, pid));
      }
      // Agent roster edge (agent membership, gap #2). Readable by any member;
      // writes go through the server API (Admin SDK) so the forward edge + the
      // /agents/{name}/assignments reverse index stay consistent — clients
      // never write it directly (no `allow write`, so editors are denied; the
      // owner could via the workspace wildcard but the app uses the server).
      match /agentMembers/{agentName} {
        allow read: if isSelf(w)
          || isProjectMember(w, pid)
          || isOrgMember(w, projectOrgId(w, pid));
      }
      // Collaborative docs workspace ("Notes"): a tree of docs (note|plan|spec),
      // each with ordered blocks, a revisions log, and its OWN discussion
      // (messages). Same access as tasks: readable by any member, writable by
      // editors/owners. The PM agent writes planGroup/planTask blocks +
      // doc messages server-side via the Tools-API (Admin SDK, which bypasses
      // these rules); these client rules govern humans editing `note` blocks
      // and posting to a doc's discussion. Listed explicitly (not
      // `{document=**}`) so the editor grant cannot reach `members`.
      match /docs/{docId} {
        allow read: if isSelf(w)
          || isProjectMember(w, pid)
          || isOrgMember(w, projectOrgId(w, pid));
        allow write: if isSelf(w) || canWriteProject(w, pid);
        match /blocks/{blockId} {
          allow read: if isSelf(w)
            || isProjectMember(w, pid)
            || isOrgMember(w, projectOrgId(w, pid));
          allow write: if isSelf(w) || canWriteProject(w, pid);
        }
        match /messages/{mid} {
          allow read: if isSelf(w)
            || isProjectMember(w, pid)
            || isOrgMember(w, projectOrgId(w, pid));
          allow write: if isSelf(w) || canWriteProject(w, pid);
        }
        match /revisions/{rev} {
          allow read: if isSelf(w)
            || isProjectMember(w, pid)
            || isOrgMember(w, projectOrgId(w, pid));
          allow write: if isSelf(w) || canWriteProject(w, pid);
        }
      }
    }

    // Default deny -------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
